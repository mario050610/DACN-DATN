# DEV ONLY. Copy to .env if you start Docker Compose or integrate services.
POSTGRES_DB=preora
POSTGRES_USER=preora
POSTGRES_PASSWORD=preora_local_dev_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://preora:preora_local_dev_only@localhost:5433/preora
# When running inside Docker, backend uses host db:5432, not localhost:5433.
AI_SERVICE_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
