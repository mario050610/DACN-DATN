<mxfile host="app.diagrams.net"><diagram id="preora-current" name="Prototype 19-10-2026"><mxGraphModel page="1" pageWidth="1280" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="PREORA · KIẾN TRÚC PROTOTYPE HIỆN TẠI (19/10/2026)" style="text;html=0;fontFamily=Helvetica;fontSize=26;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="18" width="1200" height="44" /></mxCell><mxCell id="ui" value="Frontend · React / TypeScript / Vite / Tailwind&#10;Campaign/product prototype: DemoStore + localStorage. Auth/shopping/training gọi backend.&#10;Admin: tạo và theo dõi job. Seller: đọc kết quả full đã lưu theo quyền sở hữu." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1200" height="115" /></mxCell><mxCell id="backend" value="Backend · FastAPI :8000&#10;Auth + shopping + analytics + training jobs + saved results + chat/proxy&#10;TrainingRequest validation; admin guard; seller ownership khi đọc kết quả." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ccfbf1;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="255" width="1200" height="110" /></mxCell><mxCell id="auth" value="SQLite: accounts.sqlite3&#10;Tài khoản/session/2FA&#10;Shopping theo tài khoản&#10;Checkout mô phỏng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="450" width="300" height="115" /></mxCell><mxCell id="jobs" value="SQLite: jobs.sqlite3&#10;Job, request snapshot, result&#10;Stage/events, heartbeat&#10;UI poll trạng thái/kết quả" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="450" width="340" height="115" /></mxCell><mxCell id="events" value="SQLite: behavior.sqlite3&#10;Views/clicks/favorite/cart&#10;Sự kiện từ khi bật tracker&#10;Không đủ toàn bộ lịch sử" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="450" width="340" height="115" /></mxCell><mxCell id="offline" value="Nghiên cứu offline&#10;train.py --cleaned&#10;UCI / VT / Web Robots&#10;model_artifacts/research/&#10;Chưa tự thay model phiên web" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="660" width="300" height="150" /></mxCell><mxCell id="worker" value="Python worker (subprocess)&#10;Backend khởi chạy ui_worker.py&#10;Full demo / CSV lịch sử / UCI&#10;Đọc và cập nhật jobs SQLite" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="660" width="340" height="110" /></mxCell><mxCell id="http" value="HTTP AI service :8001&#10;/health: not_loaded&#10;/forecast, /predict-success: 503&#10;Chưa tích hợp model loader&#10;Không nằm trên đường train web" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffedd5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="660" width="340" height="130" /></mxCell><mxCell id="pg" value="PostgreSQL + Docker&#10;Schema/seeds thiết kế mục tiêu&#10;Chưa là DB thống nhất&#10;cho nghiệp vụ prototype" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=16;spacing=10;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="880" width="300" height="110" /></mxCell><mxCell id